// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 유료 상세 사주 리포트 1건에 대응하는 주문. paymentId는 PortOne 결제 건 ID와 동일하며
// 결제창을 여는 시점에 우리 쪽에서 미리 발급해 중복 결제 검증의 기준으로 사용한다.
model Order {
  id          String    @id @default(cuid())
  paymentId   String    @unique
  status      OrderStatus @default(PENDING)
  amount      Int
  productType String    @default("premium_report")
  // 리포트 생성에 필요한 최소한의 생년월일시/성별 정보(JSON). 그 외 개인정보는 저장하지 않는다.
  birthInputJson String
  // 결제 완료 후 생성한 AI 해석 결과 캐시(JSON). 재조회 시 AI를 다시 호출하지 않기 위함.
  aiResultJson   String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  // 유료 궁합 주문의 상대방(제3자) 원본 생년월일시·성별을 보관기간 경과 후 파기한 시각.
  // null이면 아직 파기 대상이 아니거나(기간 미경과/생성 미완료) 궁합 상품이 아님을 뜻한다.
  partnerDataPurgedAt DateTime?
  // 카카오 로그인으로 이 주문을 자기 계정에 연결한 경우에만 채워진다(선택 기능이라 대부분
  // null — 게스트 결제는 그대로 쿠키 기반 접근만으로 동작한다). 연결하면 기기를 바꾸거나
  // 쿠키를 지워도 /my에서 다시 리포트를 찾을 수 있다.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

// 인스타 팔로우+댓글 추첨 이벤트로 매주 발급하는 무료 리포트 코드. 관리자가 /admin에서
// 코드를 발급해 당첨자에게 DM으로 전달하면, 사용자는 결제 화면에서 코드를 입력해 결제 없이
// 프리미엄 리포트를 받는다(코드 1개 = 1회용, /api/coupons/redeem에서 amount 0인 Order로 전환).
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedOrderId String?
}

// 친구 초대 보상. 무료 결과를 본 브라우저마다 하나씩 만들어지고, 공유 링크의 ?invite=<code>로
// 들어온 친구가 무료 결과까지 보면 ReferralVisit이 1건 쌓인다. 3건이 되면 무료 리포트 쿠폰을
// 발급해 couponCode에 연결한다. 생년월일시 원본은 저장하지 않고 서버 비밀키로 만든 해시만 둔다.
model Referrer {
  id         String          @id @default(cuid())
  code       String          @unique
  // 공유한 본인 생년월일시·성별의 HMAC. 본인이 자기 링크로 들어와 세는 걸 막는 용도.
  birthKey   String
  // 카카오 로그인 상태에서 만들었거나 나중에 로그인한 경우, 다른 기기에서도 진행 상황을 찾게 한다.
  userId     String?
  couponCode String?         @unique
  createdAt  DateTime        @default(now())
  visits     ReferralVisit[]

  @@index([userId])
}

model ReferralVisit {
  id         String   @id @default(cuid())
  referrerId String
  referrer   Referrer @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  // 친구 생년월일시·성별의 HMAC — 같은 친구를 두 번 세지 않기 위한 용도.
  birthKey   String
  // 요청 IP의 HMAC — 한 기기에서 생년월일만 바꿔가며 반복하는 걸 막기 위한 용도.
  ipHash     String
  createdAt  DateTime @default(now())

  @@unique([referrerId, birthKey])
  @@index([referrerId, ipHash])
}

// 결제 완료(PAID) 주문에 한해 남길 수 있는 후기. paymentId로 실제 구매를 증명하며,
// 후기 작성자의 신원(이름/연락처 등)은 별도로 저장하지 않는다.
model Review {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  productType String
  rating      Int
  content     String
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// 결제 발생 시 카카오톡 "나에게 보내기"로 알림을 보내기 위한 OAuth 토큰. 서버리스 환경(Vercel)은
// 로컬 파일에 상태를 남길 수 없어, 갱신될 때마다 이 단일 행을 갱신하는 방식으로 토큰을 유지한다.
model KakaoToken {
  id           String   @id @default("default")
  accessToken  String
  refreshToken String
  obtainedAt   DateTime @default(now())
  expiresIn    Int
}

// 브라우저 웹 푸시 구독. 회원가입이 없는 앱이라 사용자 식별 없이 구독(endpoint) 단위로만
// 저장하고, 재방문 유도(매일 오늘의 운세 알림) 발송에만 쓴다 — 이름·이메일 등과 연결하지 않는다.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// 카카오 로그인으로 만들어지는 계정. 회원가입 폼이 없는 앱이라 비밀번호는 아예 없고,
// 카카오 쪽 고유 사용자 ID만으로 식별한다 — 재접근(기기 변경 시 과거 구매 리포트 다시
// 찾기) 용도로만 쓰며, 그 외 이메일·연락처 등은 저장하지 않는다.
model User {
  id        String   @id @default(cuid())
  kakaoId   String   @unique
  nickname  String?
  createdAt DateTime @default(now())
  orders    Order[]
}

// 전환 퍼널 분석용 이벤트 로그. 생년월일·생시·성별 등 사주 입력값은 절대 담지 않는다(meta는
// productType/section 개수 같은 비민감 구조 정보만 담는 JSON 문자열).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
