{
  "crons": [
    {
      "path": "/api/internal/purge-partner-data",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/internal/reconcile-orders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/send-daily-push",
      "schedule": "0 23 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "work/**": false,
      "proto/**": false,
      "claude/**": false,
      "backup/**": false
    }
  },
  "ignoreCommand": "sh scripts/vercel-ignore.sh"
}
