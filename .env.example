# 이 파일은 값이 없는 템플릿입니다. 실제 값은 .env.local에만 넣으세요 (git에 커밋되지 않습니다).

# --- 데이터베이스 (필수) ---
# PostgreSQL 연결 문자열. Vercel + Neon Postgres 조합이면
# `vercel env pull` 로 자동으로 받아올 수 있습니다.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- 관리자 대시보드 (필수) ---
# /admin 로그인 비밀번호. 충분히 길고 무작위한 값으로 설정하세요.
ADMIN_PASSWORD=

# --- Claude API (유료 리포트의 AI 해석에 필요) ---
# https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=

# --- PortOne(포트원) 결제 연동 (결제 기능에 필요) ---
# https://admin.portone.io → 결제 연동 → 채널 관리 / 식별코드·API Keys 에서 확인
# NEXT_PUBLIC_* 값은 브라우저에 그대로 노출되는 값이라 원래 공개돼도 되는 식별자입니다(비밀키 아님).
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 결제 검증(서버 전용)에 쓰는 값 - 절대 브라우저로 노출되면 안 됩니다.
PORTONE_API_SECRET=
